NODE_ENV=development
BLOG_API_PORT=4000
BLOG_API_CORS_ORIGIN=http://localhost:5173

# Private auth key used by POST/PATCH blog routes and image upload routes.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
BLOG_PRIVATE_API_KEY=replace-with-strong-private-key

# Required for image upload endpoints (/api/blog-images and multipart heroImage uploads).
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_TOKEN=your-sanity-write-token
SANITY_API_VERSION=2024-10-01
